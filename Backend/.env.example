# ============================================================
# Backend Environment Variables — MenuBy (SisRestaurantes)
# Copy this file to .env and fill in the values.
# Variables marked [REQUIRED] will cause a fail-fast on startup.
# Variables marked [OPTIONAL] have defaults or degrade gracefully.
# ============================================================

# ── Core ─────────────────────────────────────────────────────
# [REQUIRED] MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
# [OPTIONAL] Node environment: development | production | test
NODE_ENV=development
# [OPTIONAL] Server port (default: 5000)
PORT=5000

# ── Authentication / JWT ─────────────────────────────────────
# [REQUIRED] Secret for signing access tokens (long random string)
JWT_SECRET=
# [REQUIRED] Secret for signing refresh tokens (different from JWT_SECRET)
JWT_REFRESH_SECRET=
# [REQUIRED] Google OAuth 2.0 Client ID (console.cloud.google.com → Credentials)
GOOGLE_CLIENT_ID=

# ── CORS ─────────────────────────────────────────────────────
# [OPTIONAL] Comma-separated list of allowed origins.
# If unset, defaults to menuby.tech + localhost + nip.io.
ALLOWED_ORIGINS=https://www.menuby.tech,https://menuby.tech,http://localhost:5173

# ── DigitalOcean Spaces (S3-compatible image storage) ────────
# [REQUIRED] Spaces access key (DigitalOcean → API → Spaces Keys)
DO_SPACES_KEY=
# [REQUIRED] Spaces secret key
DO_SPACES_SECRET=
# [OPTIONAL] Region (default: nyc3)
DO_SPACES_REGION=nyc3
# [OPTIONAL] Bucket name (default: menuby)
DO_SPACES_BUCKET=menuby
# [OPTIONAL] CDN URL override (default: https://<bucket>.<region>.digitaloceanspaces.com)
DO_SPACES_CDN_URL=

# ── Push Notifications (VAPID / web-push) ────────────────────
# [REQUIRED] VAPID public key (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC=
# [REQUIRED] VAPID private key
VAPID_PRIVATE=
# [OPTIONAL] Contact email for VAPID (default: mailto:admin@menuby.tech)
VAPID_MAILTO=mailto:admin@menuby.tech

# ── Email — Primary provider (Resend / Brevo / SendGrid) ────
# Set AT LEAST ONE provider key. The service tries them in order.
# [OPTIONAL] Resend API key (resend.com)
RESEND_API_KEY=
# [OPTIONAL] Brevo (ex-Sendinblue) API key
BREVO_API_KEY=
# [OPTIONAL] SendGrid API key
SENDGRID_API_KEY=
# [OPTIONAL] Sender address (default: noreply@menuby.tech)
EMAIL_FROM=noreply@menuby.tech
# [OPTIONAL] Sender display name (default: MenuBy)
EMAIL_FROM_NAME=MenuBy
# [OPTIONAL] Backend public URL used in email links (default: https://157-245-125-216.nip.io)
API_URL=https://157-245-125-216.nip.io

# ── SMTP (SuperAdmin password-reset emails) ──────────────────
# [OPTIONAL] SMTP host for superadmin transactional mail
SMTP_HOST=
# [OPTIONAL] SMTP port (default: 587)
SMTP_PORT=587
# [OPTIONAL] SMTP user
SMTP_USER=
# [OPTIONAL] SMTP password
SMTP_PASS=

# ── ePayco (Colombian payment gateway) ──────────────────────
# [OPTIONAL] ePayco public key
EPAYCO_PUBLIC_KEY=
# [OPTIONAL] ePayco private key
EPAYCO_PRIVATE_KEY=
# [OPTIONAL] Customer ID
EPAYCO_P_CUST_ID=
# [OPTIONAL] P key
EPAYCO_P_KEY=
# [OPTIONAL] true = sandbox mode, false/unset = production
EPAYCO_TEST=true

# ── dLocal Go (LATAM payment gateway) ───────────────────────
# [OPTIONAL] dLocal API key
DLOCAL_API_KEY=
# [OPTIONAL] dLocal secret key
DLOCAL_SECRET_KEY=
# [OPTIONAL] dLocal Smart Fields key (for frontend tokenization)
DLOCAL_SMART_FIELDS_KEY=
# [OPTIONAL] true = sandbox mode (default: false)
DLOCAL_TEST=false

# ── Subscriptions ────────────────────────────────────────────
# [OPTIONAL] Free trial days for new businesses (default: 7)
SUBSCRIPTION_TRIAL_DAYS=7
# [OPTIONAL] Grace days after subscription expires (default: 1)
SUBSCRIPTION_GRACE_DAYS=1

# ── URLs ─────────────────────────────────────────────────────
# [OPTIONAL] Public backend URL (default: https://157-245-125-216.nip.io)
BACKEND_URL=https://157-245-125-216.nip.io
# [OPTIONAL] Public frontend URL (default: https://menuby.tech)
FRONTEND_URL=https://menuby.tech

# ── AI / LLM ────────────────────────────────────────────────
# [OPTIONAL] Groq API key for AI chat assistant & tools (console.groq.com)
GROQ_API_KEY=

# ── Monitoring ───────────────────────────────────────────────
# [OPTIONAL] Sentry DSN for error tracking (sentry.io → Project → DSN)
SENTRY_DSN=
