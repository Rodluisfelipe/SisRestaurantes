# Variables de entorno para Digital Ocean
NODE_ENV=production
PORT=5000

# Base de datos MongoDB (mantener la actual)
MONGODB_URI=tu_string_de_conexion_mongodb

# JWT Secret (generar uno nuevo para producción)
JWT_SECRET=tu_jwt_secret_super_seguro

# CORS - Dominios permitidos
ALLOWED_ORIGINS=https://tu-dominio-vercel.vercel.app,https://www.tudominio.com

# Email (si usas nodemailer)
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_password_de_aplicacion

# Otras configuraciones
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
