{
  "version": 2,
  "name": "sisrestaurantes-frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*\\.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf|eot|mp3|wav|ogg|json|map))",
      "dest": "/$1"
    },
    {
      "src": "/(assets/.*)",
      "status": 404,
      "dest": "/404"
    },
    {
      "src": "/(.*\\.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf|eot|mp3|wav|ogg|map))",
      "status": 404,
      "dest": "/404"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    }
  ],
  "env": {
    "VITE_API_URL": "https://159-203-136-199.nip.io",
    "VITE_SOCKET_URL": "https://159-203-136-199.nip.io",
    "VITE_APP_NAME": "MenuBy",
    "VITE_APP_VERSION": "1.0.0"
  },
  "build": {
    "env": {
      "VITE_API_URL": "https://159-203-136-199.nip.io",
      "VITE_SOCKET_URL": "https://159-203-136-199.nip.io"
    }
  }
}
