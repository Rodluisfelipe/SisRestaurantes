# index.html y todas las rutas SPA nunca deben cachearse —
# necesitamos siempre la versión más nueva para resolver los hashes de assets correctos.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Rutas SPA comunes: admin, menú, pedidos, etc. Todas se sirven vía el SPA
# fallback (/* -> /index.html) y por eso DEBEN ir no-cache: si el navegador
# cachea ese HTML (heurísticamente, al no llevar Cache-Control), tras un deploy
# apunta a un chunk /assets/*.js viejo que ya no existe -> "Failed to fetch
# dynamically imported module".
/:slug/admin*
  Cache-Control: no-cache, no-store, must-revalidate

/:slug/menu*
  Cache-Control: no-cache, no-store, must-revalidate

# URL principal del QR: mesa dentro de un restaurante (carga el chunk de Menu).
/:slug/mesa*
  Cache-Control: no-cache, no-store, must-revalidate

# Slug pelado del restaurante (menuby.tech/mirestaurante) — la URL más común de
# los QR, sirve el chunk de Menu vía SPA fallback. Los landings concretos
# (/features, /pricing, /blog, ...) tienen reglas literales más específicas que
# ganan por precedencia, así que este no-cache solo afecta a slugs reales.
/:slug
  Cache-Control: no-cache, no-store, must-revalidate

# Landing pages - allow indexing
# Cache muy corto (60s) para que un deploy se propague rápido.
/
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/features
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/pricing
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/demo
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/contact
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/register
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/blog/*
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=7200

/restaurantes
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=3600

# Static assets - aggressive caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# El service worker NUNCA debe cachearse immutable: si un usuario queda con un
# SW viejo (que cacheaba /assets/), el navegador jamás lo re-descargaría y
# seguiría sirviendo chunks obsoletos → "Failed to fetch dynamically imported
# module". Regla más específica que /*.js para forzar revalidación siempre.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Images
/*.jpeg
  Cache-Control: public, max-age=604800
  
/*.jpg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

# Security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
