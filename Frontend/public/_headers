# index.html nunca debe cachearse — siempre necesitamos la versión más nueva
# para que el navegador resuelva los hashes de assets correctos.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Landing pages - allow indexing
# Cache muy corto (60s) para que un deploy se propague rápido.
/
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/features
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/pricing
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/demo
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/contact
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/register
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=60, must-revalidate

/blog/*
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=7200

/restaurantes
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=3600

# Static assets - aggressive caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Images
/*.jpeg
  Cache-Control: public, max-age=604800
  
/*.jpg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

# Security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
