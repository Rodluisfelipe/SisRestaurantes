<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Pedidos como llamada entrante: pantalla completa y prender la pantalla -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- Atiende los mensajes de Firebase antes que Expo (el de Expo tiene prioridad -1):
         los de pedidos los pinta como llamada y el resto se los pasa a Expo. -->
    <service
      android:name="tech.menuby.sistema.LlamadasService"
      android:exported="false">
      <intent-filter android:priority="10">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
