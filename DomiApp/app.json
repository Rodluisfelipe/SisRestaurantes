{
  "expo": {
    "name": "MenuBy Go",
    "slug": "domi-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/marca/icon.png",
    "scheme": "domiapp",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.menuby.domiapp",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "tech.menuby.domiapp",
      "versionCode": 20,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/marca/adaptive-icon.png",
        "backgroundColor": "#D30310"
      },
      "permissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/marca/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D30310",
          "image": "./assets/marca/splash-icon.png",
          "imageWidth": 260
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MenuBy Go usa tu ubicación para ofrecerte los pedidos más cercanos y para que el local y el cliente vean dónde vas, incluso con la pantalla apagada.",
          "locationWhenInUsePermission": "MenuBy Go usa tu ubicación para ofrecerte los pedidos más cercanos.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/marca/notification-icon.png"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/marca/notification-icon.png",
          "color": "#E11D2A",
          "sounds": [
            "./assets/sonidos/oferta.wav"
          ],
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MenuBy Go usa la cámara para tomar la foto de prueba de entrega.",
          "photosPermission": "Para elegir tu foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Expo arranca la app en segundo plano (GPS) buscando esta clase por su nombre\n-keep class expo.modules.adapters.react.apploader.** { *; }\n-keep class * implements expo.modules.apploader.HeadlessAppLoader { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9cda7f3-789c-42c5-881f-c8123baeb195"
      }
    },
    "owner": "rodluisfelipe",
    "updates": {
      "url": "https://u.expo.dev/f9cda7f3-789c-42c5-881f-c8123baeb195"
    }
  }
}
