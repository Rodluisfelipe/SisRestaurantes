{
  "expo": {
    "name": "MenuBy Go",
    "slug": "domi-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/marca/icon.png",
    "scheme": "domiapp",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.menuby.domiapp",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "tech.menuby.domiapp",
      "versionCode": 20,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/marca/adaptive-icon.png",
        "backgroundColor": "#D30310"
      },
      "permissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA",
        "SYSTEM_ALERT_WINDOW"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/marca/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D30310",
          "image": "./assets/marca/splash-icon.png",
          "imageWidth": 260
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MenuBy Go usa tu ubicación para ofrecerte los pedidos más cercanos y para que el local y el cliente vean dónde vas, incluso con la pantalla apagada.",
          "locationWhenInUsePermission": "MenuBy Go usa tu ubicación para ofrecerte los pedidos más cercanos.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/marca/notification-icon.png"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/marca/notification-icon.png",
          "color": "#E11D2A",
          "sounds": [
            "./assets/sonidos/oferta.wav"
          ],
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MenuBy Go usa la cámara para tomar la foto de prueba de entrega.",
          "photosPermission": "Para elegir tu foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Expo arranca la app en segundo plano (GPS) buscando esta clase por su nombre\n-keep class expo.modules.adapters.react.apploader.** { *; }\n-keep class * implements expo.modules.apploader.HeadlessAppLoader { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8a2763ab-8bf1-48f6-9635-e0c25cfa0dd3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8a2763ab-8bf1-48f6-9635-e0c25cfa0dd3"
    }
  }
}
