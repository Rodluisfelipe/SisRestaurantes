{
  "expo": {
    "name": "Domi App",
    "slug": "domi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0f172a",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.menuby.domiapp",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Necesitamos tu ubicación para rastrear tus entregas en tiempo real.",
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para rastrear tus entregas.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "package": "tech.menuby.domiapp",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Necesitamos tu ubicación para rastrear entregas en tiempo real.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {}
  }
}
