{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MenuBy POS",
  "version": "0.1.0",
  "identifier": "tech.menuby.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MenuBy POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "copyright": "MenuBy",
    "category": "Business",
    "shortDescription": "Punto de venta nativo",
    "longDescription": "Punto de venta local-first: cobra, imprime y abre el cajón sin depender de internet."
  }
}
